{
  "version": "2026-10-05",
  "nombre": "Registro 300 documentos gratis",
  "pasos": [
    {
      "id": "firma",
      "numero": 1,
      "titulo": "Firma electrónica",
      "requiere": ["archivo .p12 o .pfx", "clave de firma", "aceptación de términos y privacidad"],
      "checkpoint": "CP0",
      "peticiones": ["POST /api/registro/drafts", "POST /api/registro/drafts/{id}/signature-challenges", "POST /api/registro/drafts/{id}/signature-challenges/{challengeId}/verify", "POST /api/registro/drafts/{id}/certificate-package"],
      "privacidad": "la firma se abre localmente; el paquete y la clave se entregan al backend para custodia temporal y se eliminan de memoria después del upload confirmado"
    },
    {
      "id": "datos",
      "numero": 2,
      "titulo": "Datos tributarios y contacto",
      "checkpoints": ["CP1 cliente nuevo", "CP2 emisor autorizado", "CP3 datos tributarios utilizables", "CP4 contacto y correo verificado"],
      "peticiones": ["POST /api/registro/drafts/{id}/client-check", "POST /api/registro/drafts/{id}/issuer-authorization/check", "POST /api/registro/drafts/{id}/sri/lookup", "PUT /api/registro/drafts/{id}/tax-data", "PUT /api/registro/drafts/{id}/contact", "POST /api/registro/drafts/{id}/otp/email/send", "POST /api/registro/drafts/{id}/otp/email/verify"],
      "paralelismo": "issuer-authorization/check y sri/lookup empiezan juntas solo después de client-check=false",
      "bloqueo": "requiere AUTHORIZED y snapshot del mismo RUC en estado ACTIVO; tres fallos transitorios registrados habilitan MANUAL_ENTRY restringido",
      "correo": "modal/bottom sheet dentro de Datos; verificación vinculada a la dirección exacta",
      "ramas": {
        "cliente_existente": "detener promoción y mostrar portal",
        "emisor_no_autorizado": "mostrar guía y bloquear",
        "emisor_indisponible": "reintentar sin asumir resultado",
        "sri_204": "RUC no encontrado; bloquear",
        "sri_no_activo": "bloquear",
        "sri_malformado_o_ruc_distinto": "bloquear y reintentar",
        "sri_tres_fallos_transitorios": "MANUAL_ENTRY y cuenta restringida"
      }
    },
    {
      "id": "facturacion",
      "numero": 3,
      "titulo": "Información de facturación",
      "interfaz": "muestra y permite editar únicamente Factura; no pregunta si ya emitió comprobantes",
      "peticion": "PUT /api/registro/drafts/{id}/billing",
      "body": {
        "modo": "nuevo",
        "documentos": [
          { "tipo_documento": "factura", "establecimiento": "001", "punto_emision": "002", "secuencia": "000000001" },
          { "tipo_documento": "guia", "establecimiento": "001", "punto_emision": "001", "secuencia": "000000001" },
          { "tipo_documento": "nc", "establecimiento": "001", "punto_emision": "001", "secuencia": "000000001" },
          { "tipo_documento": "nd", "establecimiento": "001", "punto_emision": "001", "secuencia": "000000001" },
          { "tipo_documento": "liquidacion", "establecimiento": "001", "punto_emision": "001", "secuencia": "000000001" },
          { "tipo_documento": "retencion", "establecimiento": "001", "punto_emision": "001", "secuencia": "000000001" }
        ]
      },
      "regla": "el body no lleva wrapper; Factura conserva la edición y los otros cinco documentos usan 001/001/000000001"
    },
    {
      "id": "resumen",
      "numero": 4,
      "titulo": "Revisión y creación",
      "checkpoint": "CP5",
      "accion": "POST /api/registro/drafts/{id}/complete con Idempotency-Key"
    }
  ],
  "dependenciasSri": {
    "catastroRuc": "https://srienlinea.sri.gob.ec/sri-catastro-sujeto-servicio-internet/rest/ConsolidadoContribuyente/obtenerPorNumerosRuc?&ruc={ruc}",
    "emisorAutorizado": "https://srienlinea.sri.gob.ec/comprobantes-electronicos-internet/publico/validezEmisor.jsf",
    "comprobanteEmitidoPorClave": "https://srienlinea.sri.gob.ec/comprobantes-electronicos-internet/publico/validezComprobantes.jsf",
    "historialEmitidos": "requiere sesión autenticada en SRI en Línea; no es un endpoint público del onboarding"
  },
  "ruc": {
    "formato": "13 dígitos, terminación 001 y dígito verificador válido",
    "arquitectura": "frontend -> POST /api/registro/drafts/{id}/sri/lookup -> backend usa RUC autoritativo -> SRI",
    "estados": {
      "204": "no encontrado, sin body",
      "408_5xx": "indisponibilidad temporal; tres fallos habilitan MANUAL_ENTRY restringido",
      "malformado": "error de contrato"
    },
    "estadoPrincipal": "estadoContribuyenteRuc",
    "fechas": "informacionFechasContribuyente",
    "representanteVisible": "Solo información temporal en Firma; ausente de Datos, Revisión y payload de registro"
  }
}
