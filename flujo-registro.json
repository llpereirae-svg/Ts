{
  "version": "2026-09-29",
  "nombre": "Registro 300 documentos gratis",
  "pasos": [
    {
      "id": "firma",
      "numero": 1,
      "titulo": "Firma electrónica",
      "requiere": ["archivo .p12 o .pfx", "clave de firma", "aceptación de términos y privacidad"],
      "privacidad": "archivo y clave se procesan localmente; no forman parte del payload"
    },
    {
      "id": "datos",
      "numero": 2,
      "titulo": "Datos tributarios y contacto",
      "ruc": "GET /api/ruc/:ruc",
      "fallback": "captura manual solo ante indisponibilidad temporal, con validacionSriPendiente=true"
    },
    {
      "id": "token",
      "numero": 3,
      "titulo": "Verificación de correo",
      "endpoints": ["POST /api/token/email", "POST /api/token/verify"]
    },
    {
      "id": "facturacion",
      "numero": 4,
      "titulo": "Información de facturación",
      "pregunta": "¿Ya has emitido comprobantes electrónicos anteriormente?"
    },
    {
      "id": "resumen",
      "numero": 5,
      "titulo": "Revisión y creación",
      "accion": "POST /api/registro"
    }
  ],
  "ruc": {
    "formato": "13 dígitos, terminación 001 y dígito verificador válido",
    "arquitectura": "frontend -> API propia -> SRI",
    "estados": {
      "204": "no encontrado, sin body",
      "408_5xx": "indisponibilidad temporal",
      "malformado": "error de contrato"
    },
    "estadoPrincipal": "estadoContribuyenteRuc",
    "fechas": "informacionFechasContribuyente",
    "sociedad": "representantesLegales"
  }
}
